// Prisma schema — описывает структуру базы данных.
// После изменения этого файла нужно выполнить:
//   npx prisma migrate dev --name какое-то_имя
// Подробности — в README_DATABASE.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  name           String
  phone          String   @unique
  email          String   @unique
  password       String
  role           String   @default("client") // "client" | "admin"
  telegramChatId String?
  createdAt      DateTime @default(now())

  appointments   Appointment[]
}

model Appointment {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  userName   String
  userEmail  String
  userPhone  String
  services   String[]
  service    String
  duration   Int      @default(1)
  date       String
  time       String
  comment    String   @default("")
  status     String   @default("pending") // pending | confirmed | cancelled | completed
  source     String   @default("online")  // online | manual
  createdAt  DateTime @default(now())
}

// Блоки расписания мастера: выходные, отпуск, заблокированные слоты
model ScheduleBlock {
  id        String   @id @default(uuid())
  type      String   // day_off | vacation | blocked_slot
  date      String?  // YYYY-MM-DD (для day_off и blocked_slot)
  dateFrom  String?  // YYYY-MM-DD (для vacation — начало)
  dateTo    String?  // YYYY-MM-DD (для vacation — конец включительно)
  startTime String?  // HH:MM (только для blocked_slot)
  endTime   String?  // HH:MM (только для blocked_slot)
  reason    String   @default("") // комментарий мастера
  createdAt DateTime @default(now())
}
