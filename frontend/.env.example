# Скопируй этот файл в .env.local для локальной разработки
# На Vercel добавь эти переменные в Settings → Environment Variables

# URL твоего Railway бэкенда (без слеша в конце)
# Пример: https://kerrinails-backend-production.up.railway.app
VITE_API_URL=https://kerri-nails-rfna.vercel.app

# ─── Кнопки быстрой связи на Landing-странице ───────────────────────────
# Номер для WhatsApp: только цифры, с кодом страны, без "+", пробелов и скобок
# Пример: 79991234567
VITE_WHATSAPP_PHONE=79992488379

# Контакт для Telegram: юзернейм (без @) ИЛИ номер телефона в формате +7...
# Пример username: kerrinails_salon  →  откроется https://t.me/kerrinails_salon
# Пример телефона: +79991234567      →  откроется https://t.me/+79991234567
VITE_TELEGRAM_CONTACT=+79992488379

# ─── Соцсети в футере и на странице "Контакты" ──────────────────────────
# Полные ссылки на официальные страницы. Пока не заполните — иконки будут
# показаны, но неактивны (некликабельны), чтобы случайно не вести на
# чужую страницу. Впишите свои ссылки, например:
#   VITE_INSTAGRAM_URL=https://instagram.com/kerrinails_spb
#   VITE_VK_URL=https://vk.com/kerrinails_spb
VITE_INSTAGRAM_URL=https://www.instagram.com/kerii.nailss
VITE_VK_URL=https://vk.com/keriinailss
